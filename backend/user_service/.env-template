APP_BASE_URL=https://localhost:8000
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=false
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
ALLOWED_HOSTS=localhost,127.0.0.1

EMAIL_IMAP_HOST=
EMAIL_IMAP_SSL_PORT=993
EMAIL_IMAP_STARTTLS_PORT=143

EMAIL_POP3_HOST=
EMAIL_POP3_SSL_PORT=995
EMAIL_POP3_STARTTLS_PORT=110

EMAIL_SMTP_HOST=
EMAIL_SMTP_SSL_PORT=465
EMAIL_SMTP_STARTTLS_PORT=25
EMAIL_SMTP_ENABLED=false
EMAIL_SMTP_USE_SSL=true
EMAIL_SENDER_NAME=Auth Backend

EMAIL_USER=
EMAIL_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=auth_backend
POSTGRES_USER_TABLE=users

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

AUTH_MODE=both
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=30
SESSION_TTL_DAYS=30

AUTH_USER_TABLE=users
VERIFY_CODE_TABLE=auth_verify_codes
AUTH_REFRESH_TOKEN_TABLE=auth_refresh_tokens
AUTH_ROLE_TABLE=roles
AUTH_PERMISSION_TABLE=permissions
AUTH_USER_ROLE_TABLE=user_roles
AUTH_ROLE_PERMISSION_TABLE=role_permissions
AUTH_POLICY_RULE_TABLE=policy_rules
AUTH_SERVICE_CREDENTIAL_TABLE=service_credentials

REDIS_SESSION_PREFIX=auth:session
INTERNAL_SERVICE_TOKEN=internal-token
