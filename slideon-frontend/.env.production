# 生产环境配置

# API 基础地址 - 生产环境请修改为您的实际后端地址
VITE_API_BASE_URL=https://api.slideon.com/api

# WebSocket 地址
VITE_WS_URL=wss://api.slideon.com/ws

# 文件上传地址
VITE_UPLOAD_URL=https://api.slideon.com/api/upload

# AI 生成服务地址
VITE_AI_SERVICE_URL=https://api.slideon.com/api/ai

# 静态资源地址
VITE_ASSETS_URL=https://api.slideon.com/static

# 应用配置
VITE_APP_NAME=Slideon
VITE_APP_VERSION=1.0.0
VITE_MAX_FILE_SIZE=20971520

# 生产环境配置
VITE_DEV_MODE=false
VITE_MOCK_API=false
