        ]
      },
      {
        "id": "slide_b5cc7531e8a3",
        "intent": "text",
        "section": "核心概念",
        "title": "什么是软件工程",
        "notes": [
          "给出软件工程的定义，强调系统化、规范化、可量化的开发方法"
        ],
        "paragraphs": [
          "软件工程是将系统化、规范化、可量化的方法应用于软件的开发、运行和维护的学科。它借鉴了传统工程学的原则，旨在提高软件生产的效率和质量。",
          "其核心活动包括需求分析、设计、编码、测试和维护，每个阶段都有明确的交付物和质量标准。"
        ],
        "bullets": []
      },
      {
        "id": "slide_65857ca324d2",
        "intent": "text",
        "section": "核心概念",
        "title": "为什么需要软件工程",
        "notes": [
          "说明软件危机、质量控制、成本管理的重要性，激发学习动机"
        ],
        "paragraphs": [],
        "bullets": [
          "应对软件危机：避免项目延期、超预算、质量低下",
          "提升可维护性：降低长期维护成本，延长系统寿命",
          "保证协作效率：多人团队需要统一规范与流程",
          "管理复杂度：大型系统需要架构与设计来驾驭复杂性"
        ]
      },
      {
        "id": "slide_bf9656c5817b",
        "intent": "timeline",
        "section": "开发流程",
        "title": "软件开发生命周期",
        "notes": [
          "直观展示从需求到维护的各个阶段，建立整体流程认知"
        ],
        "events": [
          {
            "label": "需求分析",
            "date": "启动阶段",
            "detail": "与客户沟通，明确系统功能与非功能需求"
          },
          {
            "label": "设计",
            "date": "规划阶段",
            "detail": "架构设计、模块划分、接口定义"
          },
          {
            "label": "编码",
            "date": "实施阶段",
            "detail": "按设计方案编写代码，单元测试"
          },
          {
            "label": "测试",
            "date": "验证阶段",
            "detail": "集成测试、系统测试、验收测试"
          },
          {
            "label": "维护",
            "date": "运行阶段",
            "detail": "错误修正、功能升级、性能优化"
          }
        ]
      },
      {
        "id": "slide_d3aa87d3e010",
        "intent": "comparison",
        "section": "开发流程",
        "title": "瀑布模型 vs 敏捷方法",
        "notes": [
          "对比两种主流开发模式的特点、适用场景与优缺点"
        ],
        "left": {
          "title": "瀑布模型",
          "bullets": [
            "顺序执行，阶段严格分离",
            "文档驱动，前期规划完善",
            "适合需求明确、变更少的项目",
            "风险：后期发现问题代价大"
          ]
        },
        "right": {
          "title": "敏捷方法",
          "bullets": [
            "迭代增量，快速反馈",
            "沟通驱动，适应变化",
            "适合需求不确定、快速交付的项目",
            "风险：过度灵活可能缺乏文档"
          ]
        }
      },
      {
        "id": "slide_ff4ddb121c76",
        "intent": "process_flow",
        "section": "开发流程",
        "title": "典型开发流程",
        "notes": [
          "用步骤图展示需求分析、设计、编码、测试、部署的连贯性"
        ],
        "steps": [
          {
            "name": "需求分析",
            "detail": "收集、整理、确认用户需求，输出需求规格说明"
          },
          {
            "name": "设计",
            "detail": "进行系统架构与详细设计，绘制UML图"
          },
          {
            "name": "编码",
            "detail": "根据设计文档编写代码，执行代码审查"
          },
          {
            "name": "测试",
            "detail": "编写测试用例，执行各类测试并报告缺陷"
          },
          {
            "name": "部署与维护",
            "detail": "部署到生产环境，持续监控与迭代更新"
          }
        ]
      },
      {
        "id": "slide_26c98471718f",
        "intent": "text",
        "section": "具体方法",
        "title": "需求工程基础",
        "notes": [
          "介绍需求获取、分析和规格说明的方法，强调沟通的重要性"
        ],
        "paragraphs": [],
        "bullets": [
          "需求获取：访谈、问卷调查、原型演示、用户故事",
          "需求分析：识别功能需求与非功能需求，优先级排序",
          "规格说明：撰写SRS（软件需求规格说明书），确保无歧义",
          "需求验证：通过评审、确认确保需求准确完整"
        ]
      },
      {
        "id": "slide_1310e8b16fcc",
        "intent": "text",
        "section": "具体方法",
        "title": "软件设计原则",
        "notes": [
          "讲解模块化、高内聚低耦合、抽象与封装等核心设计思想"
        ],
        "paragraphs": [
          "优秀的设计应遵循模块化原则，将系统划分为独立的功能单元，每个单元职责清晰。高内聚强调模块内部元素紧密关联，低耦合则减少模块间的依赖。",
          "抽象与封装隐藏实现细节，仅暴露必要接口；开闭原则鼓励对扩展开放、对修改封闭。这些原则共同指导构建可维护、可扩展的软件系统。"
        ],
        "bullets": []
      },
