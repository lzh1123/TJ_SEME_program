    "slides": [
      {
        "id": "slide_1",
        "intent": "cover",
        "section": "开篇",
        "title": "软件工程导论",
        "notes": [
          "建立主题认知",
          "激发听众兴趣"
        ],
        "subtitle": "Software Engineering: Fundamentals and Practices",
        "tagline": "从个人项目到大规模团队协作",
        "highlights": [
          "理解软件生命周期",
          "掌握工程化方法",
          "培养质量意识"
        ]
      },
      {
        "id": "slide_2",
        "intent": "agenda",
        "section": "开篇",
        "title": "演讲议程",
        "notes": [
          "概述本次演讲的主要模块",
          "帮助听众建立预期"
        ],
        "items": [
          "什么是软件工程？",
          "软件工程 vs 计算机科学",
          "软件工程发展简史",
          "瀑布模型与敏捷开发",
          "软件质量与架构设计",
          "总结与展望"
        ]
      },
      {
        "id": "slide_3",
        "intent": "text",
        "section": "核心概念",
        "title": "什么是软件工程？",
        "notes": [
          "定义核心概念",
          "强调工程化思维"
        ],
        "paragraphs": [],
        "bullets": [
          "将系统化、规范化、可度量的方法应用于软件的开发、运行和维护",
          "包含需求获取、设计、编码、测试、部署与维护等阶段",
          "目标：在预算内按时交付可靠、满足用户需求的软件"
        ]
      },
      {
        "id": "slide_4",
        "intent": "comparison",
        "section": "核心概念",
        "title": "软件工程 vs 计算机科学",
        "notes": [
          "对比两个学科的不同侧重点",
          "帮助理解软件工程的实践属性"
        ],
        "left": {
          "title": "计算机科学",
          "bullets": [
            "理论与算法",
            "复杂度与可计算性",
            "注重抽象与证明"
          ]
        },
        "right": {
          "title": "软件工程",
          "bullets": [
            "实践与流程",
            "项目管理与协作",
            "注重质量与效率"
          ]
        }
      },
      {
        "id": "slide_5",
        "intent": "timeline",
        "section": "发展历程",
        "title": "软件工程发展简史",
        "notes": [
          "展示关键里程碑",
          "帮助理解软件工程如何演进"
        ],
        "events": [
          {
            "label": "1968 年",
            "date": "NATO 会议",
            "detail": "首次提出“软件工程”概念，应对软件危机"
          },
          {
            "label": "1970 年代",
            "date": "瀑布模型",
            "detail": "Royce 提出阶段化开发模型"
          },
          {
            "label": "1990 年代",
            "date": "敏捷宣言",
            "detail": "强调个体与互动、可工作的软件等价值观"
          },
          {
            "label": "2000 年代至今",
            "date": "DevOps / 持续交付",
            "detail": "融合开发与运维，加速交付周期"
          }
        ]
      },
      {
        "id": "slide_6",
        "intent": "process_flow",
        "section": "开发过程",
        "title": "瀑布模型",
        "notes": [
          "解释传统顺序式开发",
          "帮助理解其适用场景与局限性"
        ],
        "steps": [
          {
            "name": "需求分析",
            "detail": "明确系统功能与约束条件"
          },
          {
            "name": "系统设计",
            "detail": "划分模块、定义接口与架构"
          },
          {
            "name": "实现",
            "detail": "编写代码并进行单元测试"
          },
          {
            "name": "集成测试",
            "detail": "组合模块，验证整体功能"
          },
          {
            "name": "部署与维护",
            "detail": "交付用户并持续修正缺陷"
          }
        ]
      },
      {
        "id": "slide_7",
        "intent": "multi_column",
        "section": "开发过程",
        "title": "敏捷开发方法",
        "notes": [
          "介绍敏捷核心思想与常见框架"
        ],
        "columns": [
          {
            "title": "敏捷价值观",
            "bullets": [
              "个体与互动高于流程与工具",
              "可工作的软件高于详尽的文档",
              "客户合作高于合同谈判",
              "响应变化高于遵循计划"
            ]
          },
          {
            "title": "Scrum 框架",
            "bullets": [
              "Sprint 迭代（2-4周）",
              "每日站会",
              "Sprint 评审与回顾"
            ]
          },
          {
            "title": "极限编程 (XP)",
            "bullets": [
              "结对编程",
              "测试驱动开发",
              "持续集成"
            ]
          }
        ]
      },
      {
        "id": "slide_8",
        "intent": "roadmap",
        "section": "学习路径",
        "title": "软件工程学习路线图",
        "notes": [
          "为初学者规划逐步进阶的学习建议"
        ],
        "phases": [
          {
            "name": "基础阶段",
            "timeframe": "第1-3月",
            "deliverables": [
              "掌握一门编程语言",
              "理解数据结构与算法",
              "完成小型项目"
            ]
          },
          {
            "name": "深入学习",
            "timeframe": "第4-6月",
            "deliverables": [
              "学习需求分析与设计方法",
              "了解版本控制与测试",
              "参与开源项目"
            ]
          },
          {
            "name": "实践项目",
            "timeframe": "第7-9月",
            "deliverables": [
              "完成中规模团队项目",
              "应用敏捷实践",
              "撰写技术文档"
            ]
          },
          {
            "name": "进阶主题",
            "timeframe": "第10-12月",
            "deliverables": [
              "研究设计模式与架构",
              "接触持续集成/部署",
              "探索安全与性能工程"
            ]
          }
        ]
      },
      {
        "id": "slide_9",
        "intent": "kpi",
        "section": "质量保障",
        "title": "软件质量关键指标",
        "notes": [
          "介绍衡量软件质量的常用指标",
          "帮助建立量化思维"
        ],
        "items": [
          {
            "label": "缺陷密度",
