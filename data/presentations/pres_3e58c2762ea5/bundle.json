              "Mercurial"
            ]
          },
          {
            "title": "测试工具",
            "bullets": [
              "JUnit (单元测试)",
              "Selenium (自动化测试)",
              "JMeter (性能测试)"
            ]
          },
          {
            "title": "项目管理",
            "bullets": [
              "JIRA",
              "Trello",
              "Microsoft Project"
            ]
          }
        ]
      },
      {
        "id": "slide_12",
        "intent": "swot",
        "section": "工具与架构",
        "title": "软件工程的SWOT分析",
        "notes": [
          "分析当前软件工程的优势、劣势、机会与威胁"
        ],
        "swot": {
          "strengths": [
            "成熟的过程模型与最佳实践",
            "强大的工具生态系统",
            "不断完善的度量与质量体系"
          ],
          "weaknesses": [
            "人员技能差异大，依赖经验",
            "需求变更仍带来高风险",
            "复杂系统调试与维护成本高"
          ],
          "opportunities": [
            "人工智能辅助开发（代码生成、测试）",
            "云原生与DevOps提升自动化水平",
            "低代码/无代码平台降低门槛"
          ],
          "threats": [
            "快速变化的技术栈增加学习成本",
            "安全漏洞和隐私问题日益严峻",
            "领域特定语言兴起对通用方法的冲击"
          ]
        }
      },
